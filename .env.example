# Choose one: openai, google, anthropic, openai-compatible
MODEL_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GOOGLE_API_KEY=your-google-api-key
GOOGLE_MODEL=gemini-1.5-flash

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# OpenAI-compatible APIs, for example DeepSeek, Kimi, DashScope/Qwen, local vLLM.
OPENAI_COMPATIBLE_API_KEY=your-compatible-api-key
OPENAI_COMPATIBLE_BASE_URL=https://api.example.com/v1
OPENAI_COMPATIBLE_MODEL=provider-model-name

# Optional runtime settings
MODEL_TEMPERATURE=0.2
