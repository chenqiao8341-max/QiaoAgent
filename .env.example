# Choose one: openai, google, anthropic, openai-compatible, local-vllm, dashscope, bailian, aliyun
MODEL_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GOOGLE_API_KEY=your-google-api-key
GOOGLE_MODEL=gemini-1.5-flash

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# OpenAI-compatible APIs, for example DeepSeek, Kimi, DashScope/Qwen, local vLLM.
OPENAI_COMPATIBLE_API_KEY=your-compatible-api-key
OPENAI_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_COMPATIBLE_MODEL=qwen-plus
# Optional alias also supported by config.py:
# DASHSCOPE_API_KEY=your-bailian-api-key


# Local vLLM OpenAI-compatible server.
# /home/qiao/work/llm_deploy starts vLLM services with served_model_name from model_registry.json.
LOCAL_VLLM_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_VLLM_MODEL=qwen-3.6-35b-a3b
LOCAL_VLLM_API_KEY=local-vllm

# Optional runtime settings
MODEL_TEMPERATURE=0.2

# Show concise tool progress events while the agent works.
AGENT_SHOW_TOOL_PROGRESS=true
AGENT_RECURSION_LIMIT=100
# Research web_search budget per process. Soft limit adds synthesis reminders;
# hard limit blocks further new searches so the agent must read/write/ask instead.
AGENT_RESEARCH_SEARCH_SOFT_LIMIT=6
AGENT_RESEARCH_SEARCH_HARD_LIMIT=12
# Research browser budget per process. Page limit blocks new unique page opens;
# arXiv limit prevents one-by-one enumeration of nearby arXiv IDs.
AGENT_RESEARCH_PAGE_HARD_LIMIT=20
AGENT_RESEARCH_ARXIV_ABS_HARD_LIMIT=8

# SQLite database for long-term memory and persistent task queues.
# If unset, the agent uses AGENT_WORKSPACE_ROOT/.agent_state/agent.sqlite3.
AGENT_STATE_DB_PATH=/home/qiao/work/agent_project/.agent_state/agent.sqlite3
AGENT_MEMORY_CONTEXT_LIMIT=5
# Optional directory for interactive chat session JSONL files and session_index.jsonl.
# If unset, the agent uses the directory containing AGENT_STATE_DB_PATH.
# AGENT_SESSION_DIR=/home/qiao/work/agent_project/.agent_state

# Codex-style skills. AGENT_SKILLS_DIRS accepts multiple paths separated by ':' on Linux.
AGENT_ENABLE_SKILLS=true
AGENT_SKILLS_DIRS=/home/qiao/work/agent_project/skills:/home/qiao/.codex/skills
AGENT_SKILL_CATALOG_LIMIT=25

# Local file tools and approval behavior.
# Reads inside this directory are allowed. Reads outside it require terminal approval.
# With AGENT_ENABLE_HUMAN_APPROVAL=true, writes and shell commands ask in the terminal.
# With AGENT_ENABLE_HUMAN_APPROVAL=false, workspace writes and shell commands run automatically; outside-workspace operations are denied.
AGENT_WORKSPACE_ROOT=/home/qiao/work/agent_project
AGENT_ENABLE_HUMAN_APPROVAL=true

# Shell command tool
# Shell commands require terminal approval and are capped by timeout/output limits.
AGENT_ENABLE_SHELL_COMMANDS=true

# Web search and lightweight browser tools
AGENT_ENABLE_WEB_SEARCH=true
AGENT_ENABLE_BROWSER_TOOLS=true

# Feishu event watcher. Configure Feishu event callback URL to this service.
FEISHU_WATCH_HOST=0.0.0.0
FEISHU_WATCH_PORT=8787
FEISHU_VERIFICATION_TOKEN=
FEISHU_REPORT_INTERVAL_SECONDS=300
FEISHU_REPORT_BATCH_SIZE=10

# Codex delegation. Keep disabled until you intentionally allow this agent to launch Codex.
AGENT_ENABLE_CODEX_DELEGATION=false
# The command used by run_codex_task. Use a working proxy wrapper if official codex asks for an API key.
AGENT_CODEX_COMMAND=codex-proxy-anyrouter
